<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.autofocus"
        android:required="false" />

    <application
        android:name=".ShuleCardApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Shulecard">

        <!-- Shared Activities -->
        <activity
            android:name=".activities.shared.NotificationsActivity"
            android:exported="false" />

        <!-- Vendor Activities -->
        <activity
            android:name=".activities.vendor.ScanPaymentActivity"
            android:exported="false" />
        <activity
            android:name=".activities.vendor.VendorDashboardActivity"
            android:exported="false" />
        <activity
            android:name=".activities.vendor.VendorTransactionHistoryActivity"
            android:exported="false" />
        <activity
            android:name=".activities.vendor.VendorProfileActivity"
            android:exported="false" />
        <activity
            android:name=".activities.vendor.VendorItemsActivity"
            android:exported="false" />
        <activity
            android:name=".activities.vendor.RedeemOrderActivity"
            android:exported="false" />

        <!-- Admin Activities -->
        <activity
            android:name=".activities.admin.ReportsActivity"
            android:exported="false" />
        <activity
            android:name=".activities.admin.TransactionLogsActivity"
            android:exported="false" />
        <activity
            android:name=".activities.admin.IssueCardActivity"
            android:exported="false" />
        <activity
            android:name=".activities.admin.RegisterStudentActivity"
            android:exported="false" />
        <activity
            android:name=".activities.admin.ViewStudentsActivity"
            android:exported="false" />
        <activity
            android:name=".activities.admin.RegisterVendorActivity"
            android:exported="false" />
        <activity
            android:name=".activities.admin.ViewVendorsActivity"
            android:exported="false" />
        <activity
            android:name=".activities.admin.AdminDashboardActivity"
            android:exported="false" />
        <activity
            android:name=".activities.admin.AdminProfileActivity"
            android:exported="false" />
        <activity
            android:name=".activities.admin.PendingTopUpsActivity"
            android:exported="false" />

        <!-- Parent Activities -->
        <activity
            android:name=".activities.parent.CardManagementActivity"
            android:exported="false" />
        <activity
            android:name=".activities.parent.ParentTransactionHistoryActivity"
            android:exported="false" />
        <activity
            android:name=".activities.parent.LoadMoneyActivity"
            android:exported="false" />
        <activity
            android:name=".activities.parent.ParentDashboardActivity"
            android:exported="false" />
        <activity
            android:name=".activities.parent.ParentProfileActivity"
            android:exported="false" />

        <!-- Student Activities -->
        <activity
            android:name=".activities.student.QRCodeDisplayActivity"
            android:exported="false" />
        <activity
            android:name=".activities.student.MyBalanceActivity"
            android:exported="false" />
        <activity
            android:name=".activities.student.TransactionHistoryActivity"
            android:exported="false" />
        <activity
            android:name=".activities.student.PaymentConfirmationActivity"
            android:exported="false" />
        <activity
            android:name=".activities.student.StudentDashboardActivity"
            android:exported="false" />
        <activity
            android:name=".activities.student.StudentProfileActivity"
            android:exported="false" />
        <activity
            android:name=".activities.student.BrowseVendorsActivity"
            android:exported="false" />
        <activity
            android:name=".activities.student.VendorMenuActivity"
            android:exported="false" />
        <activity
            android:name=".activities.student.OrderQRDisplayActivity"
            android:exported="false" />

        <!-- Auth Activities -->
        <activity
            android:name=".activities.auth.SignupActivity"
            android:exported="false" />
        <activity
            android:name=".activities.auth.LoginActivity"
            android:exported="false" />
        <activity
            android:name=".activities.auth.AdminSetupActivity"
            android:exported="false" />
        <activity
            android:name=".activities.auth.ForgotPasswordActivity"
            android:exported="false" />
        <activity
            android:name=".activities.auth.SplashScreenActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>
</manifest>