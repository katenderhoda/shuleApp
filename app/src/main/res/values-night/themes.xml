<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Shulecard" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">#1E88E5</item>
        <item name="colorPrimaryVariant">#1565C0</item>
        <item name="colorOnPrimary">#FFFFFF</item>

        <!-- Secondary brand color -->
        <item name="colorSecondary">#42A5F5</item>
        <item name="colorSecondaryVariant">#1E88E5</item>
        <item name="colorOnSecondary">#FFFFFF</item>

        <!-- Status bar color -->
        <item name="android:statusBarColor">#1565C0</item>

        <!-- Background and surface colors -->
        <item name="android:windowBackground">#F5F5F5</item>
        <item name="colorSurface">#FFFFFF</item>
        <item name="colorOnSurface">#333333</item>

        <!-- Force light theme -->
        <item name="android:forceDarkAllowed">false</item>
    </style>
</resources>