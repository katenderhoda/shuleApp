<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="@color/background">

    <FrameLayout
        android:layout_width="190dp"
        android:layout_height="190dp"
        android:background="@drawable/bg_logo_card"
        android:elevation="8dp"
        android:padding="18dp">

        <ImageView
            android:id="@+id/imgSplashLogo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/shulecard_logo"
            android:contentDescription="ShuleCard Logo"
            android:scaleType="fitCenter" />
    </FrameLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ShuleCard"
        android:textSize="30sp"
        android:textStyle="bold"
        android:textColor="@color/brand_primary"
        android:layout_marginTop="24dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Go Cashless at School"
        android:textSize="16sp"
        android:textColor="@color/text_secondary"
        android:layout_marginTop="6dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Smart Money for Smart Students"
        android:textSize="13sp"
        android:textColor="@color/text_secondary"
        android:layout_marginTop="4dp" />

    <ProgressBar
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:indeterminate="true"
        android:indeterminateTint="@color/brand_primary" />
</LinearLayout>