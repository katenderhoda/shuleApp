<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbarIssueCard"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="Issue Card"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationContentDescription="Back"
            app:navigationIconTint="@color/text_on_brand" />
    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:paddingBottom="150dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Select Student"
                android:layout_marginTop="8dp"
                style="@style/TextAppearance.Shulecard.Subtitle" />

            <Spinner
                android:id="@+id/spinnerIssueCardStudent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/spinner_background"
                android:padding="12dp"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/tvStudentInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Student: James M.\nStudent ID: STU001"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/brand_primary"
                android:layout_marginTop="12dp" />

            <RadioGroup
                android:id="@+id/rgCardType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="20dp">

                <RadioButton
                    android:id="@+id/rbWristband"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Wristband" />

                <RadioButton
                    android:id="@+id/rbPlasticCard"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Plastic Card" />
            </RadioGroup>

            <TextView
                android:id="@+id/tvGeneratedCardNumber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Card Number: Not generated"
                android:textSize="16sp"
                android:layout_marginTop="20dp" />

            <TextView
                android:id="@+id/tvGeneratedPin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="PIN: Not generated"
                android:textSize="16sp"
                android:layout_marginTop="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGenerateCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="GENERATE CARD"
                android:layout_marginTop="20dp"
                style="@style/Widget.Shulecard.Button" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnIssueCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ISSUE CARD"
                android:layout_marginTop="12dp"
                style="@style/Widget.Shulecard.Button.Success" />

        </LinearLayout>
    </ScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavIssueCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        app:menu="@menu/bottom_nav_admin"
        style="@style/Widget.Shulecard.BottomNav" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>